# Paste the entire content of your Firebase Service Account JSON key as a single-line or multi-line string:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"personal-notes-app-30e1a",...}

# (Optional) A shared secret between Flutter app and backend to prevent unauthorized public calls:
RESET_SECRET_TOKEN=personal_notes_secret_token_2026

# Brevo API Key for transactional email sending (starts with xkeysib-...)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=unarmudasir@gmail.com
